{
  "name": "macro-genie",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-data.js && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "test": "node --test tests/*.test.js",
    "mcp": "node mcp/stdio.js",
    "compare": "node --env-file-if-exists=.env scripts/compare-models.js",
    "db:migrate": "npx -y netlify-cli@latest database migrations apply"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@netlify/database": "^2.0.1",
    "javascript-lp-solver": "^1.0.3",
    "jose": "^6.2.12",
    "svelte": "^5.57.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.1",
    "@netlify/vite-plugin": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "prettier": "^3.9.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  }
}
