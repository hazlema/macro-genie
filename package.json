{
  "name": "macro-genie",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-data.js && vite build",
    "preview": "vite preview --host 0.0.0.0",
