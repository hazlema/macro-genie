    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "javascript-lp-solver": "^1.0.3",
    "jose": "^6.2.12",
    "marked": "^18.1.1",
    "pg": "^8.23.1",
    "svelte": "^5.57.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.1",
    "@netlify/vite-plugin": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "prettier": "^3.9.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  }
